# SSH client config (managed by ~/Code/ohmymac)

# Machine-specific hosts and tool snippets (OrbStack, work servers) go in
# ~/.ssh/config.local, not committed. Include must come before any Host block.
Include ~/.ssh/config.local

Host *
  AddKeysToAgent yes
  UseKeychain yes
  IdentitiesOnly yes
  ServerAliveInterval 60

Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519
