# Ghostty config (managed by ~/Code/ohmymac)
# Docs: https://ghostty.org/docs/config
# Reload: Cmd+Shift+, (or Cmd+Shift+R below). Window size applies to new windows only.

# --- Window size (columns x rows) & transparency ---
window-width = 133
window-height = 40
background-opacity = 0.65
background-blur = true

# --- Font & theme ---
font-family = JetBrainsMono Nerd Font
font-size = 14
font-thicken = true
theme = Catppuccin Mocha
cursor-style = bar
cursor-style-blink = true

# --- Window ---
window-padding-x = 14
window-padding-y = 10
window-padding-balance = true
macos-titlebar-style = tabs
window-save-state = always
mouse-hide-while-typing = true
copy-on-select = clipboard
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# --- Keybinds: tmux-like splits ---
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:top
keybind = cmd+alt+down=goto_split:bottom
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+shift+r=reload_config
