[core]
	editor = nvim
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	syntax-theme = Catppuccin Mocha
[merge]
	conflictstyle = zdiff3
[diff]
	colorMoved = default
[init]
	defaultBranch = main
[pull]
	rebase = true
[url "git@github.com:"]
	# use SSH for every GitHub URL, so https clones/remotes never ask for credentials
	insteadOf = https://github.com/
	insteadOf = gh:
[push]
	autoSetupRemote = true
	default = current
[fetch]
	prune = true
[rebase]
	autoStash = true
[include]
	# user identity (name/email) and other personal bits; not committed
	path = ~/.gitconfig.local
