[core]
	editor = nvim
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	syntax-theme = Catppuccin Mocha
[merge]
	conflictstyle = zdiff3
[diff]
	colorMoved = default
[init]
	defaultBranch = main
[pull]
	rebase = true
[url "https://github.com/"]
	# gh:owner/repo shorthand
	insteadOf = gh:
[credential "https://github.com"]
	# authenticate GitHub over HTTPS with the gh CLI login (no SSH keys needed)
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[push]
	autoSetupRemote = true
	default = current
[fetch]
	prune = true
[rebase]
	autoStash = true
[include]
	# user identity (name/email) and other personal bits; not committed
	path = ~/.gitconfig.local
